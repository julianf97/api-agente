{
  "name": "api-agente",
  "version": "1.0.0",
  "description": "Minimal Express API foundation.",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/unit",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "db:migrate": "node scripts/migrate-db.js up",
    "db:migrate:undo": "node scripts/migrate-db.js down",
    "db:migrate:status": "node scripts/migrate-db.js status",
    "db:migrate:test": "node scripts/migrate-db.js up --test",
    "db:migrate:test:reset": "node scripts/migrate-db.js up --test --reset",
    "db:migrate:test:status": "node scripts/migrate-db.js status --test",
    "db:seed:demo": "node scripts/seed-demo.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14"
  }
}
